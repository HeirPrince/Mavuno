# Clerk publishable key (client — must use VITE_ prefix for Vite)
# Get from https://dashboard.clerk.com → API keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Clerk secret key (server only — do NOT prefix with VITE_)
CLERK_SECRET_KEY=sk_test_your_secret_key

# DeepSeek API key for server-side audit generation (never expose to the client bundle).
DEEPSEEK_API_KEY="your-deepseek-api-key"

# Express API port (Vite proxies /api to this port in development).
PORT=3001
