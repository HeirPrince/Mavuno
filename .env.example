# Clerk publishable key (client — must use VITE_ prefix for Vite dev/build)
# Get from https://dashboard.clerk.com → API keys
# Local: copy to .env.local. Deployed: set on the host (Express injects at runtime).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
# Optional alias accepted by the production server if VITE_ vars are unavailable at build time:
# CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Clerk secret key (server only — do NOT prefix with VITE_)
CLERK_SECRET_KEY=sk_test_your_secret_key

# Clerk webhook signature verification (Phase 1 — server only)
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret

# DeepSeek API key for server-side audit generation (never expose to the client bundle).
DEEPSEEK_API_KEY="your-deepseek-api-key"

# Express API port (Vite proxies /api to this port in development).
PORT=3001

# Supabase — VITE_ keys are safe for the client ONLY when RLS is enabled on all tables
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Africa's Talking (SMS) — required for Phase 2 notifications
AFRICASTALKING_API_KEY=your_api_key
AFRICASTALKING_USERNAME=your_username
